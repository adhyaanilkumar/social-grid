# Copy to /opt/social-grid/.env on the server and fill in. chmod 600. Never commit the real file (spec NFR7).
# Plain KEY=value lines with no spaces or quotes: release.sh reads this file in a shell as well as through Compose.

# The public host name, without https:// (for example social-grid.yourname.com).
DOMAIN=

# Commit SHA of the images to run. release.sh sets this; don't edit it by hand.
TAG=

# Production database login. Generate the password on the server with: openssl rand -hex 24
DB_USER=socialgrid
DB_PASSWORD=
