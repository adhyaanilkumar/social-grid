# Copy to /opt/social-grid/r2.env on the server, fill in, then: chmod 600 r2.env  (maintain-plan.md MT2)
# Never commit the real file. It's ignored by deploy/.gitignore.
#
# Cloudflare dashboard → R2: the account ID is on the R2 overview page. Create an API token with
# "Object Read & Write" on the social-grid-backups bucket only; it shows the access key ID and secret once.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=social-grid-backups
# healthchecks.io ping URL for the daily backup check (M3), e.g. https://hc-ping.com/<uuid>
HEALTHCHECK_URL=
